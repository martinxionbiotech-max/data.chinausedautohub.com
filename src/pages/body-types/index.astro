---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { DATA_SITE_URL } from "../../../shared/config/config";
import {
  modelsByBodyType,
  getBrand,
  countTrims,
  modelPowertrains,
  POWERTRAIN_LABELS,
  breadcrumbJsonLd,
} from "../../lib/helpers";
import { BODY_TYPE_DEFS } from "../../lib/reference";

const siteTitle = "China Used Car Database";
const pageUrl = DATA_SITE_URL + "/body-types/";
const bodyTypes = ["suv", "sedan", "mpv", "hatchback", "pickup"];
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Body Types", url: "/body-types/" },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Body Types",
    url: pageUrl,
    description: "Vehicle models grouped by body type: SUV, sedan, MPV, hatchback and pickup.",
    hasPart: bodyTypes.map((b) => ({
      "@type": "CollectionPage",
      name: BODY_TYPE_DEFS[b].title,
      url: pageUrl + "#" + b,
    })),
  },
  breadcrumbJsonLd(breadcrumbs, DATA_SITE_URL),
];
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title="Body Types — China Used Car Database"
  description="Vehicles grouped by body type — SUV, sedan, MPV, hatchback and pickup — with a plain-language definition and model list for each."
  canonical="/body-types/"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <h1>Body Types</h1>
  <p class="lede">
    Body type describes the vehicle's shape and packaging. Each section below explains
    the type and lists the models in the database.
  </p>

  <nav class="toc" aria-label="Body type index">
    {bodyTypes.map((b) => (
      <a href={`#${b}`}>{BODY_TYPE_DEFS[b].title}</a>
    ))}
  </nav>

  {bodyTypes.map((b) => {
    const list = modelsByBodyType(b);
    return (
      <section id={b} class="group">
        <h2>{BODY_TYPE_DEFS[b].title}</h2>
        <p class="def">{BODY_TYPE_DEFS[b].definition}</p>
        <p class="meta">
          {list.length} {list.length === 1 ? "model" : "models"} in the database.
        </p>
        {list.length > 0 ? (
          <div class="grid">
            {list.map((m) => {
              const brand = getBrand(m.brand_id);
              const pws = modelPowertrains(m);
              return (
                <a class="card" href={`/models/${m.model_id}/`}>
                  <h3>{m.name}</h3>
                  <p class="zh">{m.name_zh}</p>
                  <p class="meta">
                    {brand?.name ?? m.brand_id} · {countTrims(m)}{" "}
                    {countTrims(m) === 1 ? "trim" : "trims"}
                  </p>
                  <div class="tags">
                    {pws.map((p) => (
                      <span class="tag">{POWERTRAIN_LABELS[p] ?? p}</span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="vary">No models recorded for this body type yet.</p>
        )}
      </section>
    );
  })}

  <style>
    .lede { color: var(--color-text-soft); }
    .toc { display: flex; gap: var(--space-2); flex-wrap: wrap; margin: var(--space-4) 0; }
    .toc a { display: inline-block; padding: 4px 10px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 14px; }
    .group { border-top: 1px solid var(--color-border); margin-top: var(--space-5); padding-top: var(--space-4); }
    .def { color: var(--color-text-soft); }
    .meta { color: var(--color-text-soft); font-size: 13px; }
    .vary { color: var(--color-warning); font-size: 13px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); margin: var(--space-4) 0; }
    .card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); color: inherit; }
    .card:hover { text-decoration: none; box-shadow: var(--shadow-md); }
    .card h3 { margin: 0; }
    .zh { color: var(--color-text-soft); font-size: 14px; margin: var(--space-1) 0; }
    .tags { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-2); }
    .tag { display: inline-block; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; background: var(--color-accent-soft); color: var(--color-primary); }
  </style>
</BaseLayout>
