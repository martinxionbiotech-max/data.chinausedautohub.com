---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import SpecTable from "../../../shared/components/SpecTable.astro";
import SourceNote from "../../../shared/components/SourceNote.astro";
import { DATA_SITE_URL, MAIN_SITE_URL, TOOLS_SITE_URL, MARKET_SITE_URL } from "../../../shared/config/config";
import {
  models,
  getBrand,
  getModelsByBrand,
  formatYears,
  countTrims,
  countGenerations,
  modelPowertrains,
  specRows,
  confidenceLow,
  confidenceLevel,
  POWERTRAIN_LABELS,
  BODY_TYPE_LABELS,
  breadcrumbJsonLd,
} from "../../lib/helpers";
import { marketPosition, MARKET_POSITION_SOURCE, MARKET_POSITION_CONFIDENCE, MARKET_POSITION_CHECKED } from "../../lib/market-position";
import { modelOverview } from "../../lib/vehicle-overview";
import { modelMarketLinks, modelGuideLinks, modelToolLinks } from "../../lib/model-links";

export function getStaticPaths() {
  return models.map((m) => ({ params: { model: m.model_id }, props: { model: m } }));
}

const siteTitle = "China Used Car Database";
const { model } = Astro.props;
const brand = getBrand(model.brand_id);
const pageUrl = DATA_SITE_URL + `/models/${model.model_id}/`;
const gens = model.generations ?? [];

const allYears = gens.flatMap((g) => g.production_years ?? []);
const prodStart = allYears.length ? Math.min(...allYears) : null;
const prodEnd = allYears.length ? Math.max(...allYears) : null;
const prodLabel =
  prodStart != null ? (prodStart === prodEnd ? `${prodStart}` : `${prodStart}–${prodEnd}`) : "Not available";

const pws = modelPowertrains(model);
const modelLevel = confidenceLevel(model.confidence, model.source_url);

const relatedModels = getModelsByBrand(model.brand_id).filter((m) => m.model_id !== model.model_id);
const position = marketPosition[model.model_id];
const positionLevel = confidenceLevel(MARKET_POSITION_CONFIDENCE);
const overview = modelOverview(model);
const marketLinks = modelMarketLinks(model.model_id);
const guideLinks = modelGuideLinks(model);
const toolLinks = modelToolLinks(model);

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Brands", url: "/brands/" },
  ...(brand ? [{ name: brand.name, url: `/brands/${brand.brand_id}/` }] : []),
  { name: model.name, url: `/models/${model.model_id}/` },
];

// Maps a five-level confidence label to the shared badge colour class.
// Kept in the page layer (not the shared component) as required by Phase 2.
function confidenceClass(level: string): string {
  switch (level) {
    case "Source-backed":
      return "badge-high";
    case "Reported":
      return "badge-medium";
    case "Estimated":
      return "badge-low";
    default:
      return "badge-unknown";
  }
}

const vehicleLd = {
  "@context": "https://schema.org",
  "@type": "Vehicle",
  name: `${model.name}${model.name_zh ? ` (${model.name_zh})` : ""}`,
  brand: { "@type": "Brand", name: brand?.name ?? model.brand_id },
  url: pageUrl,
  description: `${model.name} (${model.name_zh}) — technical specifications by generation and trim.`,
};
const jsonLd = [vehicleLd, breadcrumbJsonLd(breadcrumbs, DATA_SITE_URL)];
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title={`${model.name} ${model.name_zh} — Specifications by Generation & Trim`}
  description={`${model.name} (${model.name_zh}) technical specifications across every generation and trim — dimensions, powertrain, range, and source-tracked data.`}
  canonical={`/models/${model.model_id}/`}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <h1>
    {model.name}
    {model.name_zh && <span class="zh"> {model.name_zh}</span>}
  </h1>

  <p class="meta">
    {brand ? <a href={`/brands/${brand.brand_id}/`}>{brand.name}</a> : model.brand_id} ·{" "}
    {BODY_TYPE_LABELS[model.body_type] ?? model.body_type} · Production {prodLabel} ·{" "}
    {countGenerations(model)} {countGenerations(model) === 1 ? "generation" : "generations"} ·{" "}
    {countTrims(model)} {countTrims(model) === 1 ? "trim" : "trims"}
  </p>

  <!-- Basic identification + Vehicle Overview (P3.4) -->
  <section class="consider">
    <h2>Vehicle Overview</h2>
    <table class="overview-table">
      <tbody>
        <tr>
          <th scope="row">Basic identification</th>
          <td>
            {model.name}
            {model.name_zh && <> ({model.name_zh})</>} · Model ID <code>{model.model_id}</code> ·{" "}
            {brand ? brand.name : model.brand_id}
          </td>
        </tr>
        {overview.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              {row.available ? row.value : <span class="vary">{row.value}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="vary">
      Values are aggregated across the listed generations and trims. Fields not
      carried by the source data are marked "Not available".
    </p>
  </section>

  <SourceNote
    source={model.source}
    sourceUrl={model.source_url}
    sourceDate={model.source_date}
    confidence={model.confidence}
  />
  <p class="confidence-line">
    Confidence level: <span class={`badge ${confidenceClass(modelLevel)}`}>{modelLevel}</span>
  </p>
  {confidenceLow(model.confidence) && (
    <p class="vary">Data may vary by market / trim / source.</p>
  )}

  <section class="consider">
    <h2>Verification Status</h2>
    <ul>
      <li>
        <strong>Source:</strong> {model.source ?? "Not available"}
      </li>
      <li>
        <strong>Last checked:</strong> {model.source_date ?? "Not available"}
      </li>
      <li>
        <strong>Verification level:</strong>{" "}
        <span class={`badge ${confidenceClass(modelLevel)}`}>{modelLevel}</span>
      </li>
    </ul>
  </section>

  {gens.map((g) => (
    <section class="generation">
      <h2>{g.name}</h2>
      <p class="meta">Production years: {formatYears(g.production_years)}</p>
      {g.trims && g.trims.length > 0 ? (
        g.trims.map((t) => {
          const rows = specRows(t.specs);
          const low = confidenceLow(t.confidence);
          const trimLevel = confidenceLevel(t.confidence, t.spec_source_url);
          return (
            <div class="trim">
              <h3>{t.name}</h3>
              <p class="meta">
                <span class="tag">{POWERTRAIN_LABELS[t.powertrain] ?? t.powertrain}</span>
                {t.production_years?.length ? (
                  <> Production years: {formatYears(t.production_years)}</>
                ) : null}
              </p>
              {rows.length > 0 ? (
                <SpecTable rows={rows} />
              ) : (
                <p class="vary">No specifications available for this trim.</p>
              )}
              <SourceNote
                source={t.spec_source}
                sourceUrl={t.spec_source_url}
                sourceDate={t.spec_source_date}
                confidence={t.confidence}
              />
              <p class="confidence-line">
                Confidence level: <span class={`badge ${confidenceClass(trimLevel)}`}>{trimLevel}</span>
              </p>
              {low && <p class="vary">Data may vary by market / trim / source.</p>}
            </div>
          );
        })
      ) : (
        <p class="vary">No trims listed for this generation.</p>
      )}
    </section>
  ))}

  <section class="consider">
    <h2>Export Considerations</h2>
    <ul>
      <li>
        <strong>Drive side:</strong> vehicles in this database are produced for the
        Chinese domestic market (left-hand drive). For right-hand-drive destinations
        such as Kenya, Tanzania or Nigeria, confirm RHD availability with the
        exporter. See the <a href={`${MARKET_SITE_URL}/countries/kenya/`}>Kenya market guide</a>.
      </li>
      <li>
        <strong>Powertrain:</strong>{" "}
        {pws.length ? pws.map((p) => POWERTRAIN_LABELS[p] ?? p).join(", ") : "Not available"}.
        {pws.some((p) => p === "ev" || p === "phev")
          ? " EV and PHEV models may benefit from duty relief in some markets — see the "
            + "EV import rules on the " + MARKET_SITE_URL + " EV guides."
          : ""}
        {" "}
        {pws.some((p) => p === "ev" || p === "phev") && (
          <a href={`${MARKET_SITE_URL}/countries/kenya/#ev-rules`}>Kenya EV rules</a>
        )}
      </li>
      <li>
        <strong>Vehicle age:</strong> some markets restrict used-vehicle age (for
        example Kenya's eight-year rule). Production years {prodLabel} — check the{" "}
        <a href={`${MARKET_SITE_URL}/countries/kenya/`}>Kenya age rules</a>.
      </li>
    </ul>
  </section>

  <section class="consider">
    <h2>China Market Position</h2>
    {position ? (
      <>
        <p>{position}</p>
        <p class="confidence-line">
          Source: {MARKET_POSITION_SOURCE} · Confidence level:{" "}
          <span class={`badge ${confidenceClass(positionLevel)}`}>{positionLevel}</span> ·{" "}
          Last checked: {MARKET_POSITION_CHECKED}
        </p>
      </>
    ) : (
      <p class="vary">Market position data not yet available.</p>
    )}
  </section>

  {relatedModels.length > 0 && (
    <section class="consider">
      <h2>Related Vehicles</h2>
      <ul class="related">
        {relatedModels.map((m) => (
          <li>
            <a href={`/models/${m.model_id}/`}>{m.name}</a>
            <span class="zh"> {m.name_zh}</span> ·{" "}
            {BODY_TYPE_LABELS[m.body_type] ?? m.body_type}
          </li>
        ))}
      </ul>
    </section>
  )}

  {marketLinks.length > 0 && (
    <section class="consider">
      <h2>Related Markets</h2>
      <ul class="related">
        {marketLinks.map((l) => (
          <li><a href={l.url}>{l.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="consider">
    <h2>Related Guides</h2>
    <ul class="related">
      {guideLinks.map((l) => (
        <li><a href={l.url}>{l.label}</a></li>
      ))}
    </ul>
  </section>

  <section class="consider">
    <h2>Related Tools</h2>
    <ul class="related">
      {toolLinks.map((l) => (
        <li><a href={l.url}>{l.label}</a></li>
      ))}
    </ul>
  </section>

  <h2>Find or request this vehicle</h2>
  <div class="cta-buttons">
    <a class="cta-primary" href={MAIN_SITE_URL + "/cars/"}>Find Available Vehicles</a>
    <a class="cta-secondary" href={MAIN_SITE_URL + "/contact/"}>Request This Vehicle</a>
  </div>
  <p class="meta">
    <a href={TOOLS_SITE_URL + "/vehicle-comparison/"}>Compare this vehicle</a> ·{" "}
    <a href={MARKET_SITE_URL}>Explore import markets</a>
  </p>

  <style>
    .zh { color: var(--color-text-soft); font-size: 24px; font-weight: 400; }
    .meta { color: var(--color-text-soft); font-size: 14px; }
    .tag { display: inline-block; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; background: var(--color-accent-soft); color: var(--color-primary); margin-right: var(--space-2); }
    .generation { border-top: 1px solid var(--color-border); margin-top: var(--space-5); padding-top: var(--space-4); }
    .trim { margin: var(--space-4) 0; }
    .trim h3 { margin: var(--space-3) 0 var(--space-1); }
    .vary { color: var(--color-warning); font-size: 13px; }
    .confidence-line { font-size: 13px; color: var(--color-text-soft); margin: var(--space-2) 0; }
    .consider { border-top: 1px solid var(--color-border); margin-top: var(--space-5); padding-top: var(--space-4); }
    .consider li { margin: var(--space-2) 0; }
    .related li { margin: var(--space-1) 0; }
    .overview-table { width: 100%; border-collapse: collapse; }
    .overview-table th, .overview-table td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-border); vertical-align: top; }
    .overview-table th { width: 30%; color: var(--color-text-soft); font-weight: 600; white-space: nowrap; }
    .related .zh { font-size: 14px; }
    .cta-buttons { display: flex; gap: var(--space-3); flex-wrap: wrap; margin: var(--space-4) 0; }
    .cta-primary { display: inline-block; background: var(--color-primary); color: #fff; padding: 10px 20px; border-radius: var(--radius-md); font-weight: 600; }
    .cta-primary:hover { text-decoration: none; background: var(--color-primary-soft); }
    .cta-secondary { display: inline-block; border: 1px solid var(--color-primary); color: var(--color-primary); padding: 10px 20px; border-radius: var(--radius-md); font-weight: 600; }
    .cta-secondary:hover { text-decoration: none; background: var(--color-accent-soft); }
  </style>
</BaseLayout>
