---
import BaseLayout from "../../shared/components/BaseLayout.astro";
import { DATA_SITE_URL } from "../../shared/config/config";

const siteTitle = "China Used Car Database";
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title="Page Not Found — China Used Car Database"
  description="The page you requested could not be found. Return to the China Used Car Database home, brand index or model index."
  canonical="/404/"
>
  <h1>Page Not Found</h1>
  <p class="lede">
    The page you're looking for doesn't exist or has moved.
  </p>
  <ul class="links">
    <li><a href="/">Back to home</a></li>
    <li><a href="/brands/">Browse brands</a></li>
    <li><a href="/models/">Browse models</a></li>
  </ul>

  <style>
    .lede { color: var(--color-text-soft); }
    .links li { margin: var(--space-2) 0; }
  </style>
</BaseLayout>
