---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { DATA_SITE_URL } from "../../../shared/config/config";
import { breadcrumbJsonLd } from "../../lib/helpers";
import { GLOSSARY_TERMS } from "../../lib/reference";

const siteTitle = "China Used Car Database";
const pageUrl = DATA_SITE_URL + "/glossary/";
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Glossary", url: "/glossary/" },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "China Used Car Database Glossary",
    url: pageUrl,
    hasDefinedTerm: GLOSSARY_TERMS.map((t) => ({
      "@type": "DefinedTerm",
      name: t.term,
      description: t.definition,
      url: pageUrl + "#" + t.id,
    })),
  },
  breadcrumbJsonLd(breadcrumbs, DATA_SITE_URL),
];
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title="Glossary — China Used Car Database"
  description="Definitions of the technical terms used across the database — E-CVT, DCT, AT, CVT, DSG, RWD, FWD, AWD, kWh, CLTC, NEDC, EREV and more."
  canonical="/glossary/"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <h1>Glossary</h1>
  <p class="lede">
    Technical terms used across the database, with short definitions and a link to the
    related page for each.
  </p>

  <dl class="glossary">
    {GLOSSARY_TERMS.map((t) => (
      <div class="term" id={t.id}>
        <dt>{t.term}</dt>
        <dd>
          {t.definition}{" "}
          <a href={t.related}>Related page →</a>
        </dd>
      </div>
    ))}
  </dl>

  <style>
    .lede { color: var(--color-text-soft); }
    .glossary { margin: var(--space-5) 0; }
    .term { border-top: 1px solid var(--color-border); padding: var(--space-3) 0; }
    .term dt { font-weight: 700; color: var(--color-primary); }
    .term dd { margin: var(--space-1) 0 0; color: var(--color-text-soft); }
  </style>
</BaseLayout>
