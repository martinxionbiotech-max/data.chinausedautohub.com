---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { DATA_SITE_URL } from "../../../shared/config/config";
import {
  modelsByPowertrain,
  getBrand,
  countTrims,
  POWERTRAIN_LABELS,
  BODY_TYPE_LABELS,
  breadcrumbJsonLd,
} from "../../lib/helpers";
import { POWERTRAIN_DEFS } from "../../lib/reference";

const siteTitle = "China Used Car Database";
const pageUrl = DATA_SITE_URL + "/powertrains/";
const powertrains = ["ev", "phev", "hev", "ice"];
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Powertrains", url: "/powertrains/" },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Powertrain Types",
    url: pageUrl,
    description: "Vehicle models grouped by powertrain type: BEV, PHEV, HEV and ICE.",
    hasPart: powertrains.map((p) => ({
      "@type": "CollectionPage",
      name: POWERTRAIN_DEFS[p].title,
      url: pageUrl + "#" + p,
    })),
  },
  breadcrumbJsonLd(breadcrumbs, DATA_SITE_URL),
];
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title="Powertrain Types — China Used Car Database"
  description="Vehicles grouped by powertrain: battery electric (BEV), plug-in hybrid (PHEV), hybrid (HEV) and internal combustion (ICE), with plain-language definitions and model lists."
  canonical="/powertrains/"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <h1>Powertrain Types</h1>
  <p class="lede">
    The database is organised around four powertrain families. Each section explains
    what the term means and lists the models that use it. See the
    <a href="/glossary/">glossary</a> for related terms such as EREV and DM-i.
  </p>

  <nav class="toc" aria-label="Powertrain index">
    {powertrains.map((p) => (
      <a href={`#${p}`}>{POWERTRAIN_DEFS[p].title}</a>
    ))}
  </nav>

  {powertrains.map((p) => {
    const list = modelsByPowertrain(p);
    return (
      <section id={p} class="group">
        <h2>{POWERTRAIN_DEFS[p].title}</h2>
        <p class="def">{POWERTRAIN_DEFS[p].definition}</p>
        <p class="meta">
          {list.length} {list.length === 1 ? "model" : "models"} in the database.
        </p>
        {list.length > 0 ? (
          <div class="grid">
            {list.map((m) => {
              const brand = getBrand(m.brand_id);
              return (
                <a class="card" href={`/models/${m.model_id}/`}>
                  <h3>{m.name}</h3>
                  <p class="zh">{m.name_zh}</p>
                  <p class="meta">
                    {brand?.name ?? m.brand_id} · {BODY_TYPE_LABELS[m.body_type] ?? m.body_type} ·{" "}
                    {countTrims(m)} {countTrims(m) === 1 ? "trim" : "trims"}
                  </p>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="vary">No models recorded for this powertrain yet.</p>
        )}
      </section>
    );
  })}

  <style>
    .lede { color: var(--color-text-soft); }
    .toc { display: flex; gap: var(--space-2); flex-wrap: wrap; margin: var(--space-4) 0; }
    .toc a { display: inline-block; padding: 4px 10px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 14px; }
    .group { border-top: 1px solid var(--color-border); margin-top: var(--space-5); padding-top: var(--space-4); }
    .def { color: var(--color-text-soft); }
    .meta { color: var(--color-text-soft); font-size: 13px; }
    .vary { color: var(--color-warning); font-size: 13px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); margin: var(--space-4) 0; }
    .card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); color: inherit; }
    .card:hover { text-decoration: none; box-shadow: var(--shadow-md); }
    .card h3 { margin: 0; }
    .zh { color: var(--color-text-soft); font-size: 14px; margin: var(--space-1) 0; }
  </style>
</BaseLayout>
