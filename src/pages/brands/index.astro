---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { DATA_SITE_URL } from "../../../shared/config/config";
import { brands, getModelsByBrand, POWERTRAIN_LABELS, breadcrumbJsonLd } from "../../lib/helpers";

const siteTitle = "China Used Car Database";
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Brands", url: "/brands/" },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Vehicle Brands",
    url: DATA_SITE_URL + "/brands/",
    hasPart: brands.map((b) => ({
      "@type": "Brand",
      name: b.name,
      url: DATA_SITE_URL + `/brands/${b.brand_id}/`,
    })),
  },
  breadcrumbJsonLd(breadcrumbs, DATA_SITE_URL),
];
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={DATA_SITE_URL}
  currentSection="data"
  title="Vehicle Brands — China Used Car Database"
  description="Every Chinese-market vehicle brand in the database — brand name, Chinese name, model count and powertrain types. Data-first, source-tracked."
  canonical="/brands/"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <h1>Vehicle Brands</h1>
  <p class="lede">
    {brands.length} brands with structured model data. Each links to its models and
    generation-level specifications.
  </p>

  <div class="grid">
    {brands.map((b) => {
      const bModels = getModelsByBrand(b.brand_id);
      return (
        <a class="card" href={`/brands/${b.brand_id}/`}>
          <h2>{b.name}</h2>
          <p class="zh">{b.name_zh}</p>
          <p class="meta">
            {bModels.length} {bModels.length === 1 ? "model" : "models"}
          </p>
          <div class="tags">
            {b.powertrains.map((p) => (
              <span class="tag">{POWERTRAIN_LABELS[p] ?? p}</span>
            ))}
          </div>
        </a>
      );
    })}
  </div>

  <style>
    .lede { color: var(--color-text-soft); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); margin: var(--space-5) 0; }
    .card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); color: inherit; }
    .card:hover { text-decoration: none; box-shadow: var(--shadow-md); }
    .card h2 { margin: 0; }
    .zh { color: var(--color-text-soft); font-size: 14px; margin: var(--space-1) 0; }
    .meta { color: var(--color-text-soft); font-size: 13px; }
    .tags { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-2); }
    .tag { display: inline-block; padding: 2px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; background: var(--color-accent-soft); color: var(--color-primary); }
  </style>
</BaseLayout>
